{
  "name": "next-app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "setup:local": "node scripts/setup-local.mjs",
    "test:api": "node --test tests/platform-api.test.mjs",
    "test:ui": "node --test tests/platform-ui.test.mjs",
    "test": "npm run test:api && npm run test:ui && npm run test:pentests",
    "test:pentests": "node --test --test-concurrency=1 tests/pentests.test.mjs tests/pentest-runtime.test.mjs tests/pentest-ui.test.mjs tests/strix-worker-runtime.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "~10.0.2",
    "@untitledui/icons": "^0.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
