diff --git a/lib/pentest-lifecycle.ts b/lib/pentest-lifecycle.ts
new file mode 100644
index 0000000..4fc8e61
--- /dev/null
+++ b/lib/pentest-lifecycle.ts
@@ -0,0 +1,162 @@
+export type PentestLifecycleStatus =
+  | "draft"
+  | "preparing"
+  | "running"
+  | "stopping"
+  | "completed"
+  | "stopped"
+  | "failed"
+  | "interrupted"
+
+export type PentestLifecycle = {
+  taskId: string
+  status: PentestLifecycleStatus
+  revision: number
+  executionId: string | null
+  ownerPid: number | null
+  workerPid: number | null
+  workerPgid: number | null
+  sandboxId: string | null
+  updatedAt: string
+  reason: string
+}
+
+type EventDetails = { executionId: string; at: string; reason: string }
+export type PentestLifecycleEvent = EventDetails &
+  (
+    | { type: "START_CONFIRMED"; ownerPid: number }
+    | { type: "STOP_REQUESTED" }
+    | { type: "CLEANUP_RECORDED" }
+    | { type: "EXECUTION_PROGRESS" }
+    | { type: "EXECUTION_COMPLETED"; finalResultPersisted: boolean }
+    | { type: "EXECUTION_FAILED"; workerPid?: number; workerPgid?: number }
+    | { type: "EXECUTION_INTERRUPTED" }
+    | {
+        type: "STOP_CONFIRMED"
+        processGroupExited: boolean
+        sandboxCleared: boolean
+      }
+    | {
+        type: "EXECUTION_STARTED"
+        workerPid: number
+        workerPgid: number
+        sandboxId: string | null
+      }
+  )
+
+export class PentestTransitionError extends Error {
+  constructor(
+    readonly code:
+      | "INVALID_TRANSITION"
+      | "STALE_EXECUTION"
+      | "CLEANUP_UNCONFIRMED"
+      | "FINAL_RESULT_UNCONFIRMED",
+    readonly status: PentestLifecycleStatus,
+    readonly event: string
+  ) {
+    super(`Invalid Pentest transition: ${status} + ${event} (${code})`)
+  }
+}
+
+export function createPentestLifecycle(input: {
+  taskId: string
+  at: string
+}): PentestLifecycle {
+  return {
+    taskId: input.taskId,
+    status: "draft",
+    revision: 0,
+    executionId: null,
+    ownerPid: null,
+    workerPid: null,
+    workerPgid: null,
+    sandboxId: null,
+    updatedAt: input.at,
+    reason: "draft_created",
+  }
+}
+
+export function transitionPentestLifecycle(
+  state: PentestLifecycle,
+  event: PentestLifecycleEvent
+): PentestLifecycle {
+  if (
+    event.type !== "START_CONFIRMED" &&
+    event.executionId !== state.executionId
+  )
+    throw new PentestTransitionError(
+      "STALE_EXECUTION",
+      state.status,
+      event.type
+    )
+  if (state.status === "stopping" && event.type === "STOP_REQUESTED")
+    return state
+  const updated = {
+    ...state,
+    revision: state.revision + 1,
+    updatedAt: event.at,
+    reason: event.reason,
+  }
+  if (
+    event.type === "CLEANUP_RECORDED" &&
+    ["stopping", "completed", "failed", "interrupted", "stopped"].includes(
+      state.status
+    )
+  )
+    return updated
+  if (state.status === "draft" && event.type === "START_CONFIRMED")
+    return {
+      ...updated,
+      status: "preparing",
+      executionId: event.executionId,
+      ownerPid: event.ownerPid,
+    }
+  if (state.status === "preparing" && event.type === "EXECUTION_STARTED")
+    return {
+      ...updated,
+      status: "running",
+      workerPid: event.workerPid,
+      workerPgid: event.workerPgid,
+      sandboxId: event.sandboxId,
+    }
+  if (
+    ["preparing", "running"].includes(state.status) &&
+    event.type === "STOP_REQUESTED"
+  )
+    return { ...updated, status: "stopping" }
+  if (state.status === "stopping" && event.type === "STOP_CONFIRMED") {
+    if (!event.processGroupExited || !event.sandboxCleared)
+      throw new PentestTransitionError(
+        "CLEANUP_UNCONFIRMED",
+        state.status,
+        event.type
+      )
+    return { ...updated, status: "stopped" }
+  }
+  if (["preparing", "running"].includes(state.status)) {
+    if (event.type === "EXECUTION_PROGRESS") return updated
+    if (event.type === "EXECUTION_FAILED")
+      return {
+        ...updated,
+        status: "failed",
+        workerPid: event.workerPid ?? state.workerPid,
+        workerPgid: event.workerPgid ?? state.workerPgid,
+      }
+    if (event.type === "EXECUTION_INTERRUPTED")
+      return { ...updated, status: "interrupted" }
+    if (event.type === "EXECUTION_COMPLETED" && state.status === "running") {
+      if (!event.finalResultPersisted)
+        throw new PentestTransitionError(
+          "FINAL_RESULT_UNCONFIRMED",
+          state.status,
+          event.type
+        )
+      return { ...updated, status: "completed" }
+    }
+  }
+  throw new PentestTransitionError(
+    "INVALID_TRANSITION",
+    state.status,
+    event.type
+  )
+}
