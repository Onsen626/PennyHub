+test("stop requests enter stopping idempotently and reject late running events", () => {
+  const preparing = transitionPentestLifecycle(
+    createPentestLifecycle({ taskId: "task-a", at: "2026-11-14T05:00:00Z" }),
+    {
+      type: "START_CONFIRMED",
+      executionId: "execution-a",
+      ownerPid: 12345,
+      at: "2026-11-14T05:01:00Z",
+      reason: "operator_confirmed",
+    }
+  )
+  const stop = {
+    type: "STOP_REQUESTED",
+    executionId: "execution-a",
+    at: "2026-11-14T05:02:00Z",
+    reason: "operator_stop",
+  }
+  const stopping = transitionPentestLifecycle(preparing, stop)
+  assert.equal(stopping.status, "stopping")
+  assert.equal(stopping.workerPid, null)
+  assert.equal(stopping.revision, 2)
+  assert.deepEqual(
+    transitionPentestLifecycle(stopping, {
+      ...stop,
+      at: "2026-11-14T05:03:00Z",
+    }),
+    stopping
+  )
+  assert.throws(
+    () =>
+      transitionPentestLifecycle(stopping, {
+        type: "EXECUTION_STARTED",
+        executionId: "execution-a",
+        workerPid: 23456,
+        workerPgid: 23456,
+        sandboxId: null,
+        at: "2026-11-14T05:04:00Z",
+        reason: "late_worker_event",
+      }),
+    (error) => error.code === "INVALID_TRANSITION"
+  )
+})
+
+test("stopped requires both process group exit and sandbox cleanup confirmation", () => {
+  const preparing = transitionPentestLifecycle(
+    createPentestLifecycle({ taskId: "task-a", at: "2026-11-14T05:00:00Z" }),
+    {
+      type: "START_CONFIRMED",
+      executionId: "execution-a",
+      ownerPid: 12345,
+      at: "2026-11-14T05:01:00Z",
+      reason: "operator_confirmed",
+    }
+  )
+  const stopping = transitionPentestLifecycle(preparing, {
+    type: "STOP_REQUESTED",
+    executionId: "execution-a",
+    at: "2026-11-14T05:02:00Z",
+    reason: "operator_stop",
+  })
+  const confirm = {
+    type: "STOP_CONFIRMED",
+    executionId: "execution-a",
+    processGroupExited: true,
+    sandboxCleared: true,
+    at: "2026-11-14T05:03:00Z",
+    reason: "resources_confirmed_clear",
+  }
