+    type: "EXECUTION_PROGRESS",
+    executionId: "e",
+    at: "c",
+    reason: "sandbox_preparing",
+  })
+  assert.equal(progress.status, "preparing")
+  assert.equal(progress.workerPid, null)
+  assert.equal(progress.revision, 2)
+  assert.equal(progress.reason, "sandbox_preparing")
+})
