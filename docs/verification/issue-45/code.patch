+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { mkdtemp, readFile, writeFile, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import path from "node:path"
+import { pathToFileURL } from "node:url"
+import ts from "typescript"
+
+const directory = await mkdtemp(path.join(tmpdir(), "penny-lifecycle-"))
+const source = await readFile("lib/pentest-lifecycle.ts", "utf8")
+await writeFile(
+  path.join(directory, "lifecycle.mjs"),
+  ts.transpileModule(source, {
+    compilerOptions: {
+      module: ts.ModuleKind.ESNext,
+      target: ts.ScriptTarget.ES2022,
+    },
+  }).outputText
+)
+const { createPentestLifecycle, transitionPentestLifecycle } = await import(
+  pathToFileURL(path.join(directory, "lifecycle.mjs"))
+)
+test.after(() => rm(directory, { recursive: true, force: true }))
+
+test("confirmed start establishes an execution identity without assigning the platform PID to the worker", () => {
+  const initial = createPentestLifecycle({
+    taskId: "task-a",
+    at: "2026-11-14T05:00:00Z",
+  })
+  const next = transitionPentestLifecycle(initial, {
+    type: "START_CONFIRMED",
+    executionId: "execution-a",
+    ownerPid: 12345,
+    at: "2026-11-14T05:01:00Z",
+    reason: "operator_confirmed",
+  })
+  assert.deepEqual(next, {
+    taskId: "task-a",
+    status: "preparing",
+    revision: 1,
+    executionId: "execution-a",
+    ownerPid: 12345,
+    workerPid: null,
+    workerPgid: null,
+    sandboxId: null,
+    updatedAt: "2026-11-14T05:01:00Z",
+    reason: "operator_confirmed",
+  })
+  assert.equal(initial.status, "draft")
+  assert.equal(initial.revision, 0)
+  assert.equal(initial.executionId, null)
+})
+
+test("only the current execution can publish its worker identity and enter running", () => {
+  const preparing = transitionPentestLifecycle(
+    createPentestLifecycle({ taskId: "task-a", at: "2026-11-14T05:00:00Z" }),
+    {
+      type: "START_CONFIRMED",
+      executionId: "execution-a",
+      ownerPid: 12345,
+      at: "2026-11-14T05:01:00Z",
+      reason: "operator_confirmed",
+    }
+  )
+  const event = {
+    type: "EXECUTION_STARTED",
+    executionId: "execution-a",
+    workerPid: 23456,
+    workerPgid: 23456,
+    sandboxId: "sandbox-a",
+    at: "2026-11-14T05:02:00Z",
+    reason: "worker_identity_confirmed",
+  }
+  const running = transitionPentestLifecycle(preparing, event)
+  assert.equal(running.status, "running")
+  assert.equal(running.revision, 2)
+  assert.equal(running.ownerPid, 12345)
+  assert.equal(running.workerPid, 23456)
+  assert.equal(running.workerPgid, 23456)
+  assert.equal(running.sandboxId, "sandbox-a")
+  assert.throws(
+    () =>
+      transitionPentestLifecycle(preparing, {
+        ...event,
+        executionId: "old-execution",
