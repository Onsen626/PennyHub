+test("startup rejects a live foreign PID without signaling it and task reads preserve the reconciled record", async () => {
+  const { platform, headers } = await bootPlatform(PREPARING)
+  try {
+    const task = await createTask(headers, platform.base)
+    await platform.stop()
+    const now = new Date().toISOString()
+    const runtimeFile = path.join(
+      platform.dataDir,
+      "pentests",
+      task.id,
+      "runtime.json"
+    )
+    await writeFile(
+      runtimeFile,
+      JSON.stringify({
+        status: "running",
+        revision: 2,
+        executionId: "foreign-execution",
+        ownerPid: 1,
+        workerPid: process.pid,
+        workerPgid: process.pid,
+        sandboxId: null,
+        pid: process.pid,
+        phase: "agent_loop",
+        startedAt: now,
+        updatedAt: now,
+        runName: task.id,
+      })
+    )
+    await writeFile(
+      path.join(platform.dataDir, "pentest-active.json"),
+      JSON.stringify({ taskId: task.id, ownerPid: 1, pid: process.pid })
+    )
+    await writeFile(
+      path.join(platform.dataDir, "sandbox-present"),
+      "fixture resource must remain untouched"
+    )
+    await platform.start()
+    const reconciled = await readTask(platform.base, task.id, headers)
+    assert.equal(reconciled.status, "interrupted")
+    assert.equal(reconciled.runtime.cleanup.processGroupExited, false)
+    assert.equal(alive(process.pid), true)
+    const commands = await readFile(
+      path.join(platform.dataDir, "sandbox-commands.log"),
+      "utf8"
+    ).catch(() => "")
+    assert.equal(
+      commands.includes("rm -f"),
+      false,
+      "unconfirmed ownership must not delete sandbox resources"
+    )
+    assert.equal(
+      existsSync(path.join(platform.dataDir, "pentest-active.json")),
+      true
+    )
+    const before = await readFile(runtimeFile, "utf8")
+    for (let count = 0; count < 3; count++)
+      await readTask(platform.base, task.id, headers)
+    assert.equal(await readFile(runtimeFile, "utf8"), before)
+  } finally {
+    await platform.dispose()
+  }
+})
+
+test("failed launch persistence retains spawned identity and blocks cleanup until group exit is confirmed", async () => {
+  const { platform, headers } = await bootPlatform(
+    "tests/helpers/pentest-unlaunched-executor-fixture.mjs"
+  )
+  let pid, taskId
+  try {
+    await writeFile(
+      path.join(platform.dataDir, "fixture-bin", "ps"),
+      "#!/bin/sh\nexit 1\n",
+      { mode: 0o700 }
+    )
+    const task = await createTask(headers, platform.base)
+    taskId = task.id
+    await mkdir(path.join(platform.dataDir, "pentests", task.id, "launch.json"))
+    assert.equal((await startTask(headers, platform.base, task.id)).status, 500)
+    const failed = await readTask(platform.base, task.id, headers)
+    pid = failed.runtime.pid
+    assert.equal(failed.status, "failed")
+    assert.equal(failed.runtime.workerPid, pid)
+    assert.equal(failed.runtime.workerPgid, pid)
+    assert.equal(alive(pid), true)
+    assert.equal(failed.runtime.cleanup.processGroupExited, false)
+    const retriedResponse = await stopTask(headers, platform.base, task.id)
+    assert.equal(retriedResponse.status, 200)
+    const retried = (await retriedResponse.json()).runtime
+    assert.equal(retried.cleanup.processGroupExited, false)
+    assert.equal(retried.endedAt, failed.runtime.endedAt)
+    assert.equal(retried.error, failed.runtime.error)
+    assert.equal(
+      existsSync(path.join(platform.dataDir, "pentest-active.json")),
+      true
+    )
+    assert.equal(
+      existsSync(path.join(platform.dataDir, "sandbox-commands.log")),
+      false
+    )
+    const other = await createTask(headers, platform.base)
+    assert.equal(
+      (await startTask(headers, platform.base, other.id)).status,
+      409
+    )
+    killGroup(pid)
+    await waitFor(
+      () => alive(pid),
+      (value) => !value
+    )
+    assert.equal((await stopTask(headers, platform.base, task.id)).status, 200)
+    assert.equal(
+      existsSync(path.join(platform.dataDir, "pentest-active.json")),
+      false
+    )
+  } finally {
+    if (!pid && taskId) {
+      // Fixture-only teardown still reaps the child when an assertion fails early.
+      try {
+        pid = Number(
+          await readFile(
+            path.join(
+              platform.dataDir,
+              "pentests",
+              taskId,
+              "work",
+              "fixture-worker.pid"
+            ),
+            "utf8"
+          )
+        )
+      } catch {
+        /* spawn may not have completed */
+      }
+    }
+    if (pid) killGroup(pid)
+    await platform.dispose()
+  }
+})
