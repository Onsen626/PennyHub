+    )
+    assert.equal(stopping.status, "stopping")
+    assert.equal(stopping.revision, 2)
+  }
+  const stopped = transitionPentestLifecycle(stopping, confirm)
+  assert.equal(stopped.status, "stopped")
+  assert.equal(stopped.revision, 3)
+  assert.throws(
+    () =>
+      transitionPentestLifecycle(stopped, {
+        type: "EXECUTION_STARTED",
+        executionId: "execution-a",
+        workerPid: 23456,
+        workerPgid: 23456,
+        sandboxId: null,
+        at: "2026-11-14T05:04:00Z",
