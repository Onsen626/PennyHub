+    {
+      type: "START_CONFIRMED",
+      executionId: "e",
+      ownerPid: 1,
+      at: "b",
+      reason: "start",
+    }
+  )
+  const stopping = transitionPentestLifecycle(preparing, {
+    type: "STOP_REQUESTED",
+    executionId: "e",
+    at: "c",
+    reason: "stop",
+  })
+  const observed = transitionPentestLifecycle(stopping, {
+    type: "CLEANUP_RECORDED",
+    executionId: "e",
+    at: "d",
+    reason: "cleanup_failed",
+  })
+  assert.equal(observed.status, "stopping")
+  assert.equal(observed.revision, 3)
+  assert.equal(observed.reason, "cleanup_failed")
+})
+
+test("execution progress updates its revision without changing status or assigning worker identity during preparation", () => {
+  const preparing = transitionPentestLifecycle(
