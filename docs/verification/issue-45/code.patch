+++ b/lib/server/pentest-manager.ts
@@ -0,0 +1,441 @@
+import "server-only"
+import { execFileSync } from "node:child_process"
+import { readFile, readdir, unlink } from "node:fs/promises"
+import path from "node:path"
+import type { PentestRuntime } from "@/lib/pentests"
+import {
+  createPentestLifecycle,
+  transitionPentestLifecycle,
+  type PentestLifecycle,
+  type PentestLifecycleEvent,
+} from "@/lib/pentest-lifecycle"
+import { dataDirectory, readRecord, writeRecord } from "./platform-store"
+import { readTaskResults } from "./findings"
+import {
+  processGroupAlive,
+  processAlive,
+  terminateProcessGroup,
+} from "./pentest-process"
+import { confirmStrixSandboxCleanup } from "./strix-sandbox"
+
+const globalManager = globalThis as typeof globalThis & {
+  __pennyPentestManager?: {
+    queues: Map<string, Promise<unknown>>
+    timer?: ReturnType<typeof setInterval>
+    ticking: boolean
+  }
+}
+const manager: NonNullable<typeof globalManager.__pennyPentestManager> =
+  (globalManager.__pennyPentestManager ??= {
+    queues: new Map(),
+    ticking: false,
+  })
+const queues = manager.queues
+export async function serializePentest<T>(
+  id: string,
+  action: () => Promise<T>
+): Promise<T> {
+  const previous = queues.get(id) ?? Promise.resolve()
+  const next = previous.catch(() => {}).then(action)
+  queues.set(id, next)
+  try {
+    return await next
+  } finally {
+    if (queues.get(id) === next) queues.delete(id)
+  }
+}
+export const runtimePath = (id: string) => `pentests/${id}/runtime.json`
+export async function releasePentestSlot(id: string) {
+  const slot = await readRecord<{ taskId: string }>("pentest-active.json")
+  if (slot?.taskId === id)
+    await unlink(path.join(dataDirectory(), "pentest-active.json")).catch(
+      () => {}
+    )
+}
+export async function savePentestTransition(
+  id: string,
+  event: PentestLifecycleEvent,
+  extra: Partial<PentestRuntime> = {}
+) {
+  const runtime = await readRecord<PentestRuntime>(runtimePath(id))
+  const initial = runtime
+    ? ({
+        taskId: id,
+        status: runtime.status,
+        revision: runtime.revision ?? 0,
+        executionId: runtime.executionId ?? null,
+        ownerPid: runtime.ownerPid ?? null,
+        workerPid: runtime.workerPid ?? null,
+        workerPgid: runtime.workerPgid ?? null,
+        sandboxId: runtime.sandboxId ?? null,
+        updatedAt: runtime.updatedAt,
+        reason: runtime.reason ?? "legacy_record",
+      } satisfies PentestLifecycle)
+    : createPentestLifecycle({ taskId: id, at: event.at })
+  const next = transitionPentestLifecycle(initial, event)
+  if (next === initial) return runtime!
+  const saved: PentestRuntime = {
+    ...(runtime ?? {
+      startedAt: event.at,
+      runName: id,
+      pid: null,
+      phase: event.reason,
+    }),
+    ...extra,
+    ...next,
+    status: next.status as PentestRuntime["status"],
+    phase: event.reason,
+    ...(["completed", "stopped", "failed", "interrupted"].includes(next.status)
+      ? { endedAt: runtime?.endedAt ?? event.at }
+      : {}),
+  }
+  await writeRecord(runtimePath(id), saved)
+  return saved
+}
+
+// Inspect the actual process command and group immediately before signaling.
+// The execution token is inherited at spawn, so task/PID reuse is not sufficient.
+export function ownsPentestWorker(runtime: PentestRuntime) {
+  if (
+    !runtime.workerPid ||
+    !runtime.workerPgid ||
+    !runtime.executionId ||
+    runtime.workerPid === process.pid
+  )
+    return false
+  try {
+    const group = execFileSync(
+      "ps",
+      ["-o", "pgid=", "-p", String(runtime.workerPid)],
+      { encoding: "utf8" }
+    ).trim()
+    const command = execFileSync(
+      "ps",
+      ["eww", "-p", String(runtime.workerPid), "-o", "command="],
+      { encoding: "utf8" }
+    )
+    return (
+      Number(group) === runtime.workerPgid &&
+      command.includes(`PENNY_EXECUTION_ID=${runtime.executionId}`)
+    )
+  } catch {
+    return false
+  }
+}
+
+export async function recordPentestCleanup(
+  id: string,
+  runtime: PentestRuntime,
+  cleanup: NonNullable<PentestRuntime["cleanup"]>
+) {
+  if (!runtime.executionId) return runtime
+  return savePentestTransition(
+    id,
+    {
+      type: "CLEANUP_RECORDED",
+      executionId: runtime.executionId,
+      at: new Date().toISOString(),
+      reason:
+        cleanup.processGroupExited && cleanup.sandboxCleared
+          ? "resources_confirmed_clear"
+          : "cleanup_unconfirmed",
+    },
+    { cleanup }
+  )
+}
+
+export async function cleanPentestExecution(
+  id: string,
+  runtime: PentestRuntime,
+  knownUnspawned = false
+) {
+  // Runtime identity survives a failed launch.json write and takes precedence.
+  let launch: {
+    executionId: string
+    workerPid: number
+    workerPgid: number
+  } | null = null
+  if (!runtime.workerPgid) {
+    try {
+      launch = await readRecord(`pentests/${id}/launch.json`)
+    } catch {
+      // Unreadable metadata supplies no evidence of process exit.
+    }
+  }
+  if (
+    !runtime.workerPid &&
+    launch &&
+    launch.executionId === runtime.executionId
+  )
+    runtime = {
+      ...runtime,
+      workerPid: launch.workerPid,
+      workerPgid: launch.workerPgid,
+    }
+  let processGroupExited =
+    knownUnspawned && !runtime.workerPgid && !runtime.pid && !runtime.cleanup
+  let error: string | undefined
+  if (runtime.workerPgid) {
+    if (!processGroupAlive(runtime.workerPgid)) processGroupExited = true
+    else if (ownsPentestWorker(runtime))
+      processGroupExited = await terminateProcessGroup(runtime.workerPgid, {
+        graceMs: 5000,
+        killGraceMs: 2000,
+        pollMs: 100,
+      })
+    else error = "执行归属尚未确认，保留活动任务名额。"
+  } else if (!processGroupExited) {
+    processGroupExited = false
+    error = "后台进程组身份未记录，保留活动任务名额。"
+  }
+  if (!processGroupExited)
+    return {
+      processGroupExited: false,
+      sandboxCleared: false,
+      error: error ?? "进程组退出尚未确认，沙箱资源保持不变。",
+    }
+  const sandbox = await confirmStrixSandboxCleanup(id)
+  const cleanup = {
+    processGroupExited,
+    ...sandbox,
+    error: error ?? sandbox.error,
+  }
+  return cleanup
+}
+
+// Call within serializePentest: all routes share confirmation, persistence and release.
+export async function finishPentestCleanup(
+  id: string,
+  runtime: PentestRuntime,
+  details?: { at: string; reason: string },
+  observed?: NonNullable<PentestRuntime["cleanup"]>
+) {
+  const cleanup = observed ?? (await cleanPentestExecution(id, runtime))
+  const confirmed = cleanup.processGroupExited && cleanup.sandboxCleared
+  const saved =
+    confirmed && runtime.status === "stopping"
+      ? await savePentestTransition(
+          id,
+          {
+            type: "STOP_CONFIRMED",
+            executionId: runtime.executionId!,
+            ...(details ?? {
+              at: new Date().toISOString(),
+              reason: "resources_confirmed_clear",
+            }),
+            ...cleanup,
+          },
+          { cleanup, error: undefined }
+        )
+      : await recordPentestCleanup(id, runtime, cleanup)
+  if (confirmed) await releasePentestSlot(id)
+  return saved
+}
+
+type ExecutionEvent = {
+  executionId: string
+  at: string
+  status: string
+  phase: string
+  error?: string
+  workerPid: number
+  workerPgid: number
+  sandboxId?: string | null
+}
+async function consumePentestEvents(id: string) {
+  let runtime = await readRecord<PentestRuntime>(runtimePath(id))
+  if (!runtime || !["preparing", "running"].includes(runtime.status)) return
+  let lines: string[] = []
+  try {
+    lines = (
+      await readFile(
+        path.join(dataDirectory(), "pentests", id, "execution-events.jsonl"),
+        "utf8"
+      )
+    )
+      .split("\n")
+      .slice(0, -1)
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error
+  }
+  for (let cursor = runtime.eventCursor ?? 0; cursor < lines.length; cursor++) {
+    const event: ExecutionEvent = JSON.parse(lines[cursor])
+    if (event.executionId !== runtime.executionId) continue
+    const details = {
+      executionId: event.executionId,
+      at: event.at,
+      reason: event.phase,
+    }
+    if (event.status === "running" && runtime.status === "preparing") {
+      const launch = await readRecord<{
+        executionId: string
+        workerPid: number
+        workerPgid: number
+      }>(`pentests/${id}/launch.json`)
+      if (
+        launch?.executionId !== runtime.executionId ||
+        event.workerPid !== launch.workerPid ||
+        event.workerPgid !== launch.workerPgid
+      )
+        continue
+      runtime = await savePentestTransition(
+        id,
+        {
+          ...details,
+          type: "EXECUTION_STARTED",
+          workerPid: event.workerPid,
+          workerPgid: event.workerPgid,
+          sandboxId: event.sandboxId ?? null,
+        },
+        { eventCursor: cursor + 1 }
+      )
+    } else if (
+      (event.status === "preparing" || event.status === "running") &&
+      event.phase !== runtime.phase
+    ) {
+      runtime = await savePentestTransition(
+        id,
+        { ...details, type: "EXECUTION_PROGRESS" },
+        { eventCursor: cursor + 1 }
+      )
+    } else if (
+      ["completed", "failed", "interrupted", "stopped"].includes(event.status)
+    ) {
+      if (event.status === "stopped") {
+        runtime = await savePentestTransition(id, {
+          ...details,
+          type: "STOP_REQUESTED",
+        })
+        runtime = await finishPentestCleanup(id, runtime, details)
+      } else {
+        let final = false
+        try {
+          final = (await readTaskResults(id))?.final === true
+        } catch {
+          /* invalid snapshot cannot confirm completion */
+        }
+        runtime = await savePentestTransition(
+          id,
+          event.status === "completed" && final
+            ? {
+                ...details,
+                type: "EXECUTION_COMPLETED",
+                finalResultPersisted: true,
+              }
+            : {
+                ...details,
+                type:
+                  event.status === "interrupted"
+                    ? "EXECUTION_INTERRUPTED"
+                    : "EXECUTION_FAILED",
+                reason:
+                  event.status === "completed"
+                    ? "final_result_unconfirmed"
+                    : event.phase,
+              },
+          {
+            error:
+              event.status === "completed" && !final
+                ? "最终结果尚未成功保存。"
+                : event.error,
+            eventCursor: cursor + 1,
+          }
+        )
+      }
+      if (event.status !== "stopped") await finishPentestCleanup(id, runtime)
+
+      return
+    }
+  }
+}
+
+export async function reconcilePentestExecution(id: string, startup = false) {
+  return serializePentest(id, async () => {
+    await consumePentestEvents(id)
+    const runtime = await readRecord<PentestRuntime>(runtimePath(id))
+    if (!runtime) return
+    const launch = runtime.workerPgid
+      ? null
+      : await readRecord<{
+          executionId: string
+          workerPid: number
+          workerPgid: number
+        }>(`pentests/${id}/launch.json`)
+    const workerPid =
+      runtime.workerPid ??
+      (launch && launch.executionId === runtime.executionId
+        ? launch.workerPid
+        : null)
+    const identity = {
+      ...runtime,
+      workerPid,
+      workerPgid: runtime.workerPgid ?? launch?.workerPgid,
+    }
+    if (runtime.status === "stopping" && startup && runtime.executionId) {
+      await finishPentestCleanup(id, runtime, {
+        at: new Date().toISOString(),
+        reason: "startup_stop_confirmed",
+      })
+    } else if (
+      ["preparing", "running"].includes(runtime.status) &&
+      (!workerPid ||
+        !processAlive(workerPid) ||
+        (startup && !ownsPentestWorker(identity)))
+    ) {
+      if (runtime.ownerPid === process.pid && !workerPid) return
+      if (runtime.executionId) {
+        const next = await savePentestTransition(id, {
+          type: "EXECUTION_INTERRUPTED",
+          executionId: runtime.executionId,
+          at: new Date().toISOString(),
+          reason: "startup_execution_missing",
+        })
+        await finishPentestCleanup(id, next)
+      } else {
+        await writeRecord(runtimePath(id), {
+          ...runtime,
+          status: "interrupted",
+          revision: (runtime.revision ?? 0) + 1,
+          reason: "legacy_identity_not_recorded",
+          error: "旧记录未记录执行身份与清理信息。",
+          updatedAt: new Date().toISOString(),
+        })
+      }
+    } else if (
+      ["completed", "failed", "interrupted"].includes(runtime.status) &&
+      (startup || !runtime.cleanup) &&
+      (!runtime.cleanup?.sandboxCleared || !runtime.cleanup?.processGroupExited)
+    ) {
+      await finishPentestCleanup(id, runtime)
+    }
+  })
+}
+export async function startPentestManager() {
+  if (manager.timer) return
+  const tick = async (startup = false) => {
+    if (manager.ticking) return
+    manager.ticking = true
+    try {
+      let ids: string[]
+      try {
+        ids = await readdir(path.join(dataDirectory(), "pentests"))
+      } catch {
+        return
+      }
+      await Promise.all(
+        ids
+          .filter((id) => /^[a-f0-9-]{36}$/.test(id))
+          .map((id) =>
+            reconcilePentestExecution(id, startup).catch((error) =>
+              console.error("Pentest reconciliation failed", id, error)
+            )
+          )
+      )
+    } finally {
+      manager.ticking = false
+    }
+  }
+  await tick(true)
+  manager.timer = setInterval(() => void tick(), 200)
+  manager.timer.unref()
+}
