+    assert.equal((await startTask(headers, platform.base, next.id)).status, 409)
+    await (
+      await import("node:fs/promises")
+    ).unlink(path.join(platform.dataDir, "sandbox-present"))
+    await writeFile(
+      path.join(platform.dataDir, "sandbox-failure"),
+      "fixture command fails"
+    )
+    const again = (
+      await (await stopTask(headers, platform.base, task.id)).json()
+    ).runtime
+    assert.equal(again.status, "stopping")
+    assert.ok(again.revision > pending.revision)
+    await platform.stop()
+    await platform.start()
+    const restarted = await readTask(platform.base, task.id, headers)
+    assert.equal(restarted.status, "stopping")
+    assert.ok(
+      restarted.runtime.revision > again.revision,
+      "startup must check the pending cleanup"
+    )
+    await (
+      await import("node:fs/promises")
+    ).unlink(path.join(platform.dataDir, "sandbox-failure"))
+    const retried = (
+      await (await stopTask(headers, platform.base, task.id)).json()
+    ).runtime
+    assert.equal(retried.status, "stopped")
+    assert.deepEqual(retried.cleanup, {
+      processGroupExited: true,
+      sandboxCleared: true,
+    })
+    const repeated = (
+      await (await stopTask(headers, platform.base, task.id)).json()
+    ).runtime
+    assert.equal(repeated.revision, retried.revision)
+    await (
+      await import("node:fs/promises")
+    ).appendFile(
+      eventFile,
+      JSON.stringify({
+        executionId: identity,
+        at: new Date().toISOString(),
+        status: "running",
+        phase: "late_running",
+        workerPid,
+        workerPgid: workerPid,
+      }) + "\n"
+    )
+    await new Promise((resolve) => setTimeout(resolve, 500))
+    const late = await readTask(platform.base, task.id, headers)
+    assert.equal(late.status, "stopped")
+    assert.equal(late.runtime.revision, retried.revision)
+    assert.equal(
+      existsSync(path.join(platform.dataDir, "pentest-active.json")),
+      false
+    )
+  } finally {
+    if (workerPid && alive(workerPid)) killGroup(workerPid)
+    await platform.dispose()
+  }
+})
