+test("completion requires a durable final result and failures and interruptions preserve identity", () => {
+  const initial = createPentestLifecycle({ taskId: "task-a", at: "a" })
+  const preparing = transitionPentestLifecycle(initial, {
+    type: "START_CONFIRMED",
+    executionId: "e",
+    ownerPid: 12,
+    at: "b",
+    reason: "start",
+  })
+  const running = transitionPentestLifecycle(preparing, {
+    type: "EXECUTION_STARTED",
+    executionId: "e",
+    workerPid: 13,
+    workerPgid: 13,
+    sandboxId: null,
+    at: "c",
+    reason: "started",
+  })
+  const event = {
+    type: "EXECUTION_COMPLETED",
+    executionId: "e",
+    finalResultPersisted: false,
+    at: "d",
+    reason: "finished",
+  }
+  assert.throws(
+    () => transitionPentestLifecycle(running, event),
+    (error) => error.code === "FINAL_RESULT_UNCONFIRMED"
+  )
+  assert.equal(
+    transitionPentestLifecycle(running, {
+      ...event,
+      finalResultPersisted: true,
+    }).status,
+    "completed"
+  )
+  assert.equal(
+    transitionPentestLifecycle(preparing, {
+      ...event,
+      type: "EXECUTION_FAILED",
+    }).status,
+    "failed"
+  )
+  assert.equal(
+    transitionPentestLifecycle(running, {
+      ...event,
+      type: "EXECUTION_INTERRUPTED",
+    }).status,
+    "interrupted"
+  )
+})
+
+test("cleanup observations preserve lifecycle status and increment the public revision", () => {
