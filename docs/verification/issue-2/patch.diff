+  assert.ok(!text.includes("test-only-secret-002"))
+  assert.deepEqual(JSON.parse(text), {
+    configured: true,
+    baseUrl: "http://127.0.0.1:9876/v1",
+    model: "test-model",
+    hasApiKey: true,
+    updatedAt: JSON.parse(text).updatedAt,
