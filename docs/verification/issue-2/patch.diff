+          </p>
+        </div>
+        <div className="space-y-2">
+          <label htmlFor="model-name" className="text-sm font-medium">
+            模型名称
+          </label>
+          <Input
+            id="model-name"
+            required
+            maxLength={200}
+            placeholder="接口实际提供的模型标识"
+            value={model}
+            disabled={disabled}
+            onChange={(e) => {
+              setModel(e.target.value)
+              setFeedback(null)
