+        }
+        const result = await response.json()
+        if (!active) return
+        if (!response.ok) {
+          setFeedback({
+            message: result.error?.message || "读取配置失败。",
+            error: true,
+          })
+          return
+        }
+        setSaved(result)
+        setBaseUrl(result.baseUrl)
+        setModel(result.model)
+      } catch {
+        if (active)
+          setFeedback({
+            message: "读取配置失败，请检查平台服务。",
+            error: true,
+          })
+      } finally {
+        if (active) setLoading(false)
+      }
+    }
+    void load()
+    return () => {
+      active = false
+    }
