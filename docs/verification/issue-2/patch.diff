+    await save({ baseUrl, model: "new-model", apiKey: "" })
+    await fetch(`${base}/api/model-config/test`, {
+      method: "POST",
+      headers,
+      body: JSON.stringify({ baseUrl, model: "new-model", apiKey: "" }),
+    })
