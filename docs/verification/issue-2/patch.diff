+        </div>
+        <p className="text-xs leading-relaxed text-muted-foreground">
+          测试连接会向当前地址发送一次实际模型请求，可能产生少量调用费用；连接成功不代表已验证
+          Strix 全部工具调用能力。
+        </p>
+        {feedback && (
+          <p
+            role={feedback.error ? "alert" : "status"}
+            className={`text-sm ${feedback.error ? "text-red-600" : "text-emerald-600"}`}
